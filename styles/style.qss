/* QSS for SmartParkingSystem - Dark Theme */

/* General Window Styling */
QMainWindow, QDialog {
    background-color: #181d27; /* Dark background */
    font-family: "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
    min-width: 350px; /* Set a minimum width for all dialogs to prevent title compression */
}

/* General Label Styling */
QLabel {
    font-size: 15px; /* Increased font size */
    color: #e0e0e0; /* Light text for dark background */
}

/* PushButton General Styling */
QPushButton {
    color: white;
    border-radius: 5px; /* Slightly more rounded */
    padding: 10px 20px; /* Increased padding */
    font-size: 15px; /* Increased font size */
    font-weight: bold;
    border: none;
    min-width: 90px; /* Increased min-width */
}

/* OK/Confirm/Login Button Styling */
QPushButton#pushButtonLogin,
QPushButton#pushButtonOK,
QPushButton#pushButtonRegister {
    background-color: #0066cc; /* Blue for confirmation */
}

QPushButton#pushButtonLogin:hover,
QPushButton#pushButtonOK:hover,
QPushButton#pushButtonRegister:hover {
    background-color: #3385d6; /* Lighter blue on hover */
}

QPushButton#pushButtonLogin:pressed,
QPushButton#pushButtonOK:pressed,
QPushButton#pushButtonRegister:pressed {
    background-color: #004c99; /* Darker blue when pressed */
}

/* Cancel Button Styling */
QPushButton#pushButtonCancel {
    background-color: #e74856; /* Red for cancellation/danger */
}

QPushButton#pushButtonCancel:hover {
    background-color: #ed6c78; /* Lighter red on hover */
}

QPushButton#pushButtonCancel:pressed {
    background-color: #c4313f; /* Darker red when pressed */
}

/* LineEdit Styling */
QLineEdit {
    background-color: #2c313a; /* Darker input field */
    border: 1px solid #4f5b6a; /* Subtle border */
    border-radius: 5px;
    padding: 8px; /* Increased padding */
    font-size: 15px; /* Increased font size */
    color: #e0e0e0; /* Light text */
}

QLineEdit:focus {
    border-color: #0066cc; /* Blue highlight on focus */
    outline: none;
}

/* ComboBox Styling */
QComboBox {
    background-color: #2c313a; /* Match LineEdit */
    border: 1px solid #4f5b6a;
    border-radius: 5px;
    padding: 8px;
    color: #e0e0e0;
    font-size: 15px;
}

QComboBox:focus {
    border-color: #0066cc;
}

QComboBox::drop-down {
    border: none;
    background-color: transparent;
}

QComboBox::down-arrow {
    image: url(:/icons/down_arrow.png); /* You need to add this icon to your resources */
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background-color: #2c313a;
    border: 1px solid #4f5b6a;
    selection-background-color: #0066cc; /* Blue for selection */
    color: #e0e0e0;
}


/* GroupBox Styling for visual separation */
QGroupBox {
    border: 1px solid #4f5b6a;
    border-radius: 5px;
    margin-top: 10px;
    font-weight: bold;
    color: #e0e0e0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px; /* Increased padding */
    background-color: #181d27; /* Match window background */
}


/* MessageBox Styling */
QMessageBox {
    min-width: 300px; /* Prevent title text compression */
}

QMessageBox QLabel {
    color: #e0e0e0; /* Ensure text is light */
    font-size: 15px; /* Increased font size */
}

QMessageBox QPushButton { /* Style all buttons inside QMessageBox */
    background-color: #0066cc; /* Blue for confirmation */
    min-width: 90px;
}

QMessageBox QPushButton:hover {
    background-color: #3385d6;
}

QMessageBox QPushButton:pressed {
    background-color: #004c99;
}

/* Tab Widget Styling */
QWidget#dashboardTab, QWidget#vehicleTab, QWidget#accountTab, QWidget#myPageTab {
    background-color: #232a35;
}

QTabWidget::pane {
    border: none; /* Remove the default border around the content */
}

QTabBar::tab {
    background-color: #181d27;
    color: #e0e0e0;
    padding: 10px 22px; /* Increased padding */
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border: 1px solid #4f5b6a;
    border-bottom: none;
    margin-right: 2px;
    font-weight: bold; /* Bold tab text */
}

QTabBar::tab:selected {
    background-color: #232a35; /* Match the content pane background */
    border-color: #4f5b6a;
}

QTabBar::tab:!selected:hover {
    background-color: #2c313a;
}

/* Pay Button Specific Styling */
QPushButton#pushButtonPay {
    background-color: #32f08c;
    color: #000000; /* Black text for light green background */
}

QPushButton#pushButtonPay:hover {
    background-color: #62f3a7;
}

QPushButton#pushButtonPay:pressed {
    background-color: #28b86b;
}

/* Vehicle Management Button Styling */
QPushButton#pushButtonAddVehicle {
    background-color: #32f08c; /* Match Pay button for consistency */
    color: #000000;
}
QPushButton#pushButtonAddVehicle:hover { background-color: #62f3a7; }
QPushButton#pushButtonAddVehicle:pressed { background-color: #28b86b; }

QPushButton#pushButtonEditVehicle {
    background-color: #0066cc; /* Blue for editing/confirmation */
}
QPushButton#pushButtonEditVehicle:hover { background-color: #3385d6; }
QPushButton#pushButtonEditVehicle:pressed { background-color: #004c99; }

QPushButton#pushButtonDeleteVehicle {
    background-color: #e74856; /* Red for deletion/danger */
}
QPushButton#pushButtonDeleteVehicle:hover { background-color: #ed6c78; }
QPushButton#pushButtonDeleteVehicle:pressed { background-color: #c4313f; }

/* Account Management Button Styling */
QPushButton#pushButtonAddUser {
    background-color: #32f08c;
    color: #000000;
}
QPushButton#pushButtonAddUser:hover { background-color: #62f3a7; }
QPushButton#pushButtonAddUser:pressed { background-color: #28b86b; }

QPushButton#pushButtonEditUser {
    background-color: #0066cc;
}
QPushButton#pushButtonEditUser:hover { background-color: #3385d6; }
QPushButton#pushButtonEditUser:pressed { background-color: #004c99; }

QPushButton#pushButtonDeleteUser {
    background-color: #e74856;
}
QPushButton#pushButtonDeleteUser:hover { background-color: #ed6c78; }
QPushButton#pushButtonDeleteUser:pressed { background-color: #c4313f; }

/* Query Button Styling */
QPushButton#pushButtonQuery {
    background-color: #0066cc; /* Blue for primary actions */
    color: white;
}
QPushButton#pushButtonQuery:hover { background-color: #3385d6; }
QPushButton#pushButtonQuery:pressed { background-color: #004c99; }

QPushButton#pushButtonIntelligentQuery {
    background-color: #32f08c; /* Green for go/add */
    color: #000000;
}
QPushButton#pushButtonIntelligentQuery:hover { background-color: #62f3a7; }
QPushButton#pushButtonIntelligentQuery:pressed { background-color: #28b86b; }

/* My Page Button Styling */
QPushButton#pushButtonChangePassword {
    background-color: #e74856; /* Red for critical actions */
}
QPushButton#pushButtonChangePassword:hover { background-color: #ed6c78; }
QPushButton#pushButtonChangePassword:pressed { background-color: #c4313f; }

QPushButton#pushButtonBindVehicle {
    background-color: #0066cc; /* Blue for primary actions */
}
QPushButton#pushButtonBindVehicle:hover { background-color: #3385d6; }
QPushButton#pushButtonBindVehicle:pressed { background-color: #004c99; }

QPushButton#monthlyPassButton {
    background-color: #0066cc; /* Blue for primary actions */
}
QPushButton#monthlyPassButton:hover { background-color: #3385d6; }
QPushButton#monthlyPassButton:pressed { background-color: #004c99; }

QLabel#labelQueryPlate {
    font-size: 16px;
    font-weight: bold;
    color: #e0e0e0;
    padding-bottom: 10px;
}

/* Custom MessageBox Button Styling */
QPushButton#msgBoxConfirmButton {
    background-color: #0066cc; /* Blue for confirmation */
}
QPushButton#msgBoxConfirmButton:hover { background-color: #3385d6; }
QPushButton#msgBoxConfirmButton:pressed { background-color: #004c99; }

QPushButton#msgBoxCancelButton {
    background-color: #e74856; /* Red for cancellation/danger */
}
QPushButton#msgBoxCancelButton:hover { background-color: #ed6c78; }
QPushButton#msgBoxCancelButton:pressed { background-color: #c4313f; }

/* === TableView General Styling === */
QTableView {
    background-color: #2d2d2d; /* Set background for the entire view, including empty areas */
    gridline-color: #4f5b6a;
    border: 1px solid #4f5b6a;
    color: #e0e0e0;
    font-size: 14px; /* Explicitly set font size for table content */
}

QTableView::viewport {
    background-color: #2d2d2d; /* Ensure the item area background matches */
}

/* === Table Header Styling === */
QHeaderView {
    background-color: #3c3c3c; /* Set background for the entire header, including empty areas */
}

QHeaderView::section {
    background-color: #3c3c3c;
    color: #e0e0e0;
    padding: 8px; /* Increased padding */
    border: 1px solid #4f5b6a;
    font-weight: bold; /* Bold header text */
}

/* === Table Corner Button (Top-Left) Styling === */
QTableView QTableCornerButton::section {
    background-color: #3c3c3c;
    border: 1px solid #4f5b6a;
}

/* === 'My Page' Styling === */
QWidget#scrollAreaWidgetContents {
    background-color: #2d2d2d; /* Set the background for the entire scrollable area */
    border: none;
}

QWidget#scrollAreaWidgetContents QGroupBox {
    /* The border is set dynamically in C++, so we only set the background here */
    background-color: #181d27;
    padding: 10px; /* Add internal padding */
    margin-bottom: 10px; /* Add spacing between cards */
}

/* === ScrollBar Styling === */
QScrollBar:vertical {
    border: none;
    background: #2d2d2d;
    width: 12px; /* Slightly wider */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:vertical {
    background: #4f5b6a; /* Scroller color */
    min-height: 25px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #5a687a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: #2d2d2d;
    height: 12px; /* Slightly wider */
    margin: 0px 0px 0px 0px;
}

QScrollBar::handle:horizontal {
    background: #4f5b6a;
    min-width: 25px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #5a687a;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
}

/* Upload Button Styling */
QPushButton#pushButtonUpload,
QPushButton#pushButtonUpload_Leave {
    background-color: #32f08c; /* Green like Add Vehicle */
    color: #000000;
}
QPushButton#pushButtonUpload:hover,
QPushButton#pushButtonUpload_Leave:hover { background-color: #62f3a7; }
QPushButton#pushButtonUpload:pressed,
QPushButton#pushButtonUpload_Leave:pressed { background-color: #28b86b; }

/* Intelligent Bind Button Styling */
QPushButton#pushButtonIntelligentBind {
    background-color: #32f08c; /* Green for go/add */
    color: #000000;
}
QPushButton#pushButtonIntelligentBind:hover { background-color: #62f3a7; }
QPushButton#pushButtonIntelligentBind:pressed { background-color: #28b86b; }
