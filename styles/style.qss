/* ============================================================================
   SmartParkingSystem - Material Design 3 (Dark) Theme
   ----------------------------------------------------------------------------
   Qt5 QSS implementation of Google Material Design 3 (M3, dark color scheme).
   Baseline palette seed: #6750A4 (M3 baseline purple).

   M3 color tokens used:
     Primary              #D0BCFF   OnPrimary              #381E72
     PrimaryContainer     #4F378B   OnPrimaryContainer     #EADDFF
     SecondaryContainer   #4A4458   OnSecondaryContainer   #E8DEF8
     Error                #F2B8B5   OnError                #601410
     Surface              #1C1B1F   OnSurface              #E6E1E5
     SurfaceVariant       #49454F   OnSurfaceVariant       #CAC4D0
     Outline              #938F99   OutlineVariant         #49454F
     SurfaceContainerLowest #141218  Low #1D1B20  Default #211F26
                                  High #2B2930  Highest #36343B
   Semantic accents (license plate types / fees):
     Blue #90CAF9 | Green #8CE0A8 | Amber #FFD66E
   ========================================================================== */

/* ---------------- 1. Base windows & widgets ---------------- */
QMainWindow, QDialog {
    background-color: #1C1B1F;
    color: #E6E1E5;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    min-width: 350px;
}

QWidget {
    color: #E6E1E5;
    font-size: 14px;
}

/* ---------------- 2. Labels ---------------- */
QLabel {
    color: #E6E1E5;
    font-size: 14px;
    background: transparent;
}

QLabel#labelTitle {
    font-size: 22px;
    font-weight: 600;
    color: #D0BCFF;
}

QLabel#labelUsernameHeader {
    font-size: 18px;
    font-weight: 600;
    color: #E6E1E5;
}

QLabel#labelQueryPlate {
    font-size: 16px;
    font-weight: 600;
    color: #E6E1E5;
    padding-bottom: 8px;
}

QLabel#labelPlateValue {
    font-size: 18px;
    font-weight: 700;
}

QLabel#labelPlateResult,
QLabel#labelParkingFeeValue {
    font-size: 16px;
    font-weight: 600;
}

QLabel#occupancyStatsLabel,
QLabel#revenueStatsLabel {
    color: #CAC4D0;
}

QLabel#labelImagePreview,
QLabel#labelImagePreview_Leave {
    border: 1px solid #49454F;
    border-radius: 16px;
    background-color: #211F26;
    color: #938F99;
    padding: 8px;
}

QLabel#labelRecognitionResult,
QLabel#labelRecognitionResult_Leave {
    color: #CAC4D0;
    font-size: 14px;
}

/* ---------------- 3. PushButtons (M3 Filled is the default) ---------------- */
QPushButton {
    background-color: #D0BCFF;
    color: #381E72;
    border: none;
    border-radius: 12px;
    padding: 9px 20px;
    min-width: 84px;
    min-height: 20px;
    font-size: 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #C5B0F6;
}

QPushButton:pressed {
    background-color: #A893E2;
}

QPushButton:disabled {
    background-color: #36343B;
    color: #938F99;
}

/* M3 Outlined: cancel / dismiss actions */
QPushButton#pushButtonCancel,
QPushButton#msgBoxCancelButton {
    background-color: transparent;
    color: #D0BCFF;
    border: 1px solid #938F99;
    border-radius: 12px;
    padding: 8px 19px;
}

QPushButton#pushButtonCancel:hover,
QPushButton#msgBoxCancelButton:hover {
    background-color: rgba(208, 188, 255, 8%);
    border-color: #D0BCFF;
}

QPushButton#pushButtonCancel:pressed,
QPushButton#msgBoxCancelButton:pressed {
    background-color: rgba(208, 188, 255, 16%);
}

QPushButton#pushButtonCancel:disabled,
QPushButton#msgBoxCancelButton:disabled {
    background-color: transparent;
    border-color: #49454F;
    color: #938F99;
}

/* M3 Tonal: edit / secondary actions */
QPushButton#pushButtonEditVehicle,
QPushButton#pushButtonEditUser,
QPushButton#pushButtonChangePassword,
QPushButton#monthlyPassButton {
    background-color: #4A4458;
    color: #E8DEF8;
}

QPushButton#pushButtonEditVehicle:hover,
QPushButton#pushButtonEditUser:hover,
QPushButton#pushButtonChangePassword:hover,
QPushButton#monthlyPassButton:hover {
    background-color: #554E66;
}

QPushButton#pushButtonEditVehicle:pressed,
QPushButton#pushButtonEditUser:pressed,
QPushButton#pushButtonChangePassword:pressed,
QPushButton#monthlyPassButton:pressed {
    background-color: #5E576F;
}

/* M3 Error: delete / destructive actions */
QPushButton#pushButtonDeleteVehicle,
QPushButton#pushButtonDeleteUser {
    background-color: #F2B8B5;
    color: #601410;
}

QPushButton#pushButtonDeleteVehicle:hover,
QPushButton#pushButtonDeleteUser:hover {
    background-color: #F5C3C1;
}

QPushButton#pushButtonDeleteVehicle:pressed,
QPushButton#pushButtonDeleteUser:pressed {
    background-color: #E59E9A;
}

/* Semantic success: payment */
QPushButton#pushButtonPay {
    background-color: #8CE0A8;
    color: #00391C;
    min-width: 110px;
}

QPushButton#pushButtonPay:hover {
    background-color: #9DE7B6;
}

QPushButton#pushButtonPay:pressed {
    background-color: #6DD391;
}

/* ---------------- 4. Inputs ---------------- */
QLineEdit,
QComboBox {
    background-color: #36343B;
    border: 1px solid #49454F;
    border-radius: 12px;
    padding: 8px 12px;
    color: #E6E1E5;
    font-size: 14px;
    selection-background-color: #4F378B;
    selection-color: #EADDFF;
}

QLineEdit:hover,
QComboBox:hover {
    border-color: #938F99;
}

QLineEdit:focus,
QComboBox:focus {
    border: 2px solid #D0BCFF;
    padding: 7px 11px;
}

QLineEdit:disabled,
QComboBox:disabled {
    background-color: #1D1B20;
    border-color: #36343B;
    color: #938F99;
}

QLineEdit {
    placeholder-text-color: #938F99;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url(:/icons/down_arrow.png);
    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    background-color: #2B2930;
    border: 1px solid #49454F;
    border-radius: 12px;
    padding: 6px;
    color: #E6E1E5;
    selection-background-color: #4A4458;
    selection-color: #E8DEF8;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    border-radius: 8px;
    min-height: 20px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(230, 225, 229, 8%);
}

/* ---------------- 5. Radio buttons ---------------- */
QRadioButton {
    color: #E6E1E5;
    font-size: 14px;
    spacing: 10px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #938F99;
    border-radius: 10px;
    background: transparent;
}

QRadioButton::indicator:hover {
    border-color: #D0BCFF;
}

QRadioButton::indicator:checked {
    border: 2px solid #D0BCFF;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5, stop: 0 #D0BCFF, stop: 0.35 #D0BCFF, stop: 0.45 transparent, stop: 1 transparent);
}

QRadioButton::indicator:disabled {
    border-color: #49454F;
}

QRadioButton:disabled {
    color: #938F99;
}

/* ---------------- 6. GroupBox (M3 outlined cards) ---------------- */
QGroupBox {
    background-color: #211F26;
    border: 1px solid #49454F;
    border-radius: 16px;
    margin-top: 1.4em;
    padding: 12px;
    color: #E6E1E5;
    font-size: 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 16px;
    padding: 0 6px;
    background-color: #211F26;
    color: #E6E1E5;
    font-weight: 600;
}

/* ---------------- 7. Tabs (M3 primary underline indicator) ---------------- */
QTabWidget::pane {
    border: none;
    background-color: #1C1B1F;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #CAC4D0;
    padding: 10px 20px;
    margin-right: 4px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 14px;
    font-weight: 500;
}

QTabBar::tab:hover {
    background-color: rgba(230, 225, 229, 6%);
    color: #E6E1E5;
}

QTabBar::tab:selected {
    color: #D0BCFF;
    border-bottom: 2px solid #D0BCFF;
    font-weight: 600;
}

QTabBar::tab:disabled {
    color: #938F99;
}

/* ---------------- 8. Tables ---------------- */
QTableView {
    background-color: #211F26;
    alternate-background-color: #1D1B20;
    gridline-color: #36343B;
    border: 1px solid #49454F;
    border-radius: 16px;
    padding: 4px;
    color: #E6E1E5;
    font-size: 14px;
    selection-background-color: #4F378B;
    selection-color: #EADDFF;
}

QTableView::item {
    padding: 6px 8px;
    border: none;
}

QTableView::item:hover {
    background-color: rgba(230, 225, 229, 6%);
}

QTableView::item:selected {
    background-color: #4F378B;
    color: #EADDFF;
}

QHeaderView {
    background: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #2B2930;
    color: #CAC4D0;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid #49454F;
    font-weight: 600;
}

QTableView QTableCornerButton::section {
    background-color: #2B2930;
    border: none;
}

/* ---------------- 9. Scroll bars ---------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #49454F;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #938F99;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #49454F;
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #938F99;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical,
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    height: 0;
    background: none;
    border: none;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------------- 10. Menus ---------------- */
QMenuBar {
    background-color: #211F26;
    color: #E6E1E5;
    border-bottom: 1px solid #49454F;
    padding: 2px;
}

QMenuBar::item {
    padding: 7px 14px;
    border-radius: 8px;
    background: transparent;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #4A4458;
    color: #E8DEF8;
}

QMenu {
    background-color: #2B2930;
    color: #E6E1E5;
    border: 1px solid #49454F;
    border-radius: 12px;
    padding: 6px;
}

QMenu::item {
    padding: 8px 28px 8px 14px;
    border-radius: 8px;
    background: transparent;
}

QMenu::item:selected {
    background-color: #4A4458;
    color: #E8DEF8;
}

QMenu::item:disabled {
    color: #938F99;
}

QMenu::separator {
    height: 1px;
    background: #49454F;
    margin: 6px 10px;
}

/* ---------------- 11. Message box ---------------- */
QMessageBox {
    background-color: #1C1B1F;
}

QMessageBox QLabel {
    color: #E6E1E5;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 90px;
}

/* ---------------- 12. Scroll area & status bar ---------------- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QWidget#scrollAreaWidgetContents {
    background: transparent;
    border: none;
}

QStatusBar {
    background-color: #211F26;
    color: #CAC4D0;
    border-top: 1px solid #49454F;
}

QStatusBar::item {
    border: none;
}

/* ---------------- 13. Tooltips ---------------- */
QToolTip {
    background-color: #36343B;
    color: #E6E1E5;
    border: 1px solid #49454F;
    border-radius: 8px;
    padding: 6px 10px;
}
